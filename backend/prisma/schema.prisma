generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  phone        String?
  city         String?
  country      String?
  bio          String?
  language     String   @default("English")
  createdAt    DateTime @default(now())

  trips            Trip[]
  wishlist         UserWishlist[]
  communityReviews CommunityReview[]
}

model Trip {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  coverImageUrl String?
  startDate     DateTime
  endDate       DateTime
  totalBudget   Float    @default(0.0)
  isPublic      Boolean  @default(false)
  shareSlug     String   @unique
  createdAt     DateTime @default(now())

  stops          TripStop[]
  sections       TripSection[]
  expenses       ExpenseItem[]
  checklistItems TripChecklistItem[]
}

model TripSection {
  id            String    @id @default(uuid())
  tripId        String
  trip          Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sectionNumber Int
  title         String
  description   String?
  startDate     DateTime?
  endDate       DateTime?
  budget        Float     @default(0.0)
  createdAt     DateTime  @default(now())
}

model City {
  id              String   @id @default(uuid())
  name            String
  country         String
  region          String
  costIndex       String   // low, medium, high
  popularityScore Float    @default(0.0)
  imageUrl        String
  description     String

  activities Activity[]
  tripStops  TripStop[]
  wishlist   UserWishlist[]
}

model TripStop {
  id            String   @id @default(uuid())
  tripId        String
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  cityId        String
  city          City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  orderIndex    Int
  arrivalDate   DateTime
  departureDate DateTime
  stayCost      Float    @default(0.0)
  transportCost Float    @default(0.0)

  stopActivities StopActivity[]
  expenses       ExpenseItem[]
}

model Activity {
  id              String @id @default(uuid())
  cityId          String
  city            City   @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name            String
  category        String // Sightseeing, Food, Adventure, Culture, Leisure
  cost            Float
  durationMinutes Int
  imageUrl        String
  description     String

  stopActivities StopActivity[]
}

model StopActivity {
  id            String    @id @default(uuid())
  tripStopId    String
  tripStop      TripStop  @relation(fields: [tripStopId], references: [id], onDelete: Cascade)
  activityId    String
  activity      Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  scheduledDate DateTime?
  scheduledTime String?
  customCost    Float?
  notes         String?
  orderIndex    Int       @default(0)
}

model ExpenseItem {
  id         String    @id @default(uuid())
  tripId     String
  trip       Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripStopId String?
  tripStop   TripStop? @relation(fields: [tripStopId], references: [id], onDelete: SetNull)
  category   String    // transport, stay, activity, meal, misc
  amount     Float
  date       DateTime  @default(now())
  note       String?
}

model CurrencyRate {
  code           String @id
  symbol         String
  rateAgainstUSD Float
}

model TripChecklistItem {
  id          String  @id @default(uuid())
  tripId      String
  trip        Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title       String
  category    String  // Essentials, Packing, Adventure, Culture, Food, Documents
  isCompleted Boolean @default(false)
}

model UserWishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cityId    String
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, cityId])
}

model CommunityReview {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cityName  String
  rating    Int      @default(5)
  title     String
  content   String
  createdAt DateTime @default(now())
}
